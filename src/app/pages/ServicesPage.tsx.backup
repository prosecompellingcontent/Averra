            isMobile ? "min-h-[600px] mb-0" : "min-h-svh"
          }`}
        >
          {/* Background image as a pinned rectangle */}
          <div
            className={`${
              isMobile
                ? "relative w-full min-h-[600px]"
                : "absolute inset-0 w-full h-full"

                </div>

                <div className="grid md:grid-cols-2 gap-6">
                  {brandAlignmentService.deliverables.map((item, index) => (
                    <div key={index} className="flex items-start gap-4 bg-white/30 p-6 border-l-2 border-[#b76e79]/40">
                      <div className="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-[#b76e79]/10">
                        <Check
                          className="w-5 h-5 text-[#b76e79]"
                          strokeWidth={2}
                        />
                      </div>
                      <span className="text-base text-[#301710] font-light leading-relaxed">{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* PRICING AT THE BOTTOM - Luxury Editorial */}
            <div className="relative max-w-5xl mx-auto">
              <div className="relative bg-white/50 p-12 md:p-16 overflow-hidden">
                {/* Decorative corner elements */}
                <div className="absolute top-0 left-0 w-20 h-20 border-t-2 border-l-2 border-[#b76e79]/20"></div>
                <div className="absolute top-0 right-0 w-20 h-20 border-t-2 border-r-2 border-[#b76e79]/20"></div>
                <div className="absolute bottom-0 left-0 w-20 h-20 border-b-2 border-l-2 border-[#b76e79]/20"></div>
                <div className="absolute bottom-0 right-0 w-20 h-20 border-b-2 border-r-2 border-[#b76e79]/20"></div>

                {/* Content */}
                <div className="relative z-10 text-center">
                  <div className="mb-8">
                    <div className="inline-block px-8 py-2 bg-[#b76e79]/10 border border-[#b76e79]/30 mb-6">
                      <p className="text-xs uppercase tracking-[0.4em] text-[#b76e79]">
                        Founding Member Pricing
                      </p>
                    </div>

                    <div className="flex items-center justify-center gap-6 mb-2">
                      <span
                        className="text-4xl text-[#301710]/30 line-through"
                        style={{
                          fontFamily: "Cormorant, serif",
                          fontWeight: 300,
                        }}
                      >
                        {brandAlignmentService.price}
                      </span>
                      <div className="relative">
                        <div className="absolute inset-0 bg-[#b76e79]/5 blur-xl"></div>
                        <span
                          className="relative text-7xl md:text-8xl text-[#301710]"
                          style={{
                            fontFamily: "Cormorant, serif",
                            fontWeight: 300,
                          }}
                        >
                          {brandAlignmentService.salePrice}
                        </span>
                      </div>
                    </div>

                    <p className="text-sm text-[#654331]/60 uppercase tracking-[0.2em] mb-10">
                      Limited Time Offer
                    </p>
                  </div>

                  {/* CTA Button with luxury styling */}
                  <button
                    onClick={() => {
                      sessionStorage.setItem(
                        "selectedServiceTier",
                        JSON.stringify({
                          id: brandAlignmentService.id,
                          name: brandAlignmentService.name,
                          priceNum: brandAlignmentService.priceNum,
                          originalPriceNum: brandAlignmentService.originalPriceNum,
                          subtitle: brandAlignmentService.subtitle,
                          type: "service",
                          description: brandAlignmentService.description,
                        })
                      );
                      navigate("/brand-intake");
                    }}
                    className={`group relative inline-block px-20 py-6 bg-[#301710] text-[#f4e4e6] text-center text-sm uppercase tracking-[0.4em] font-light overflow-hidden ${
                      !isMobile ? "hover:bg-[#b76e79] hover:scale-105 hover:shadow-2xl" : ""
                    } transition-all duration-500 cursor-pointer mb-8`}
                  >
                    <span className="relative z-10">Begin Alignment</span>
                    {/* Hover shine effect */}
                    <div className={`absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full ${!isMobile ? "group-hover:translate-x-full" : ""} transition-transform duration-1000`}></div>
                  </button>

                  <div className="max-w-2xl mx-auto">
                    <div className="h-px bg-gradient-to-r from-transparent via-[#b76e79]/30 to-transparent mb-6"></div>
                    <p
                      className="text-lg text-[#301710]/70 font-light italic"
                      style={{ fontFamily: "Cormorant, serif" }}
                    >
                      Your brand becomes clear, consistent, and recognizable — aligned with its intended level and no longer creating confusion or resetting over time.
                    </p>
                  </div>
                </div>
              </div>
            </div>
            </div>
          </div>
        </div>

        {/* Audit Add-Ons Section */}
        <div className="bg-[#f4e4e6] py-32 relative overflow-hidden">
          {/* Decorative blur elements */}
          <div className="absolute top-20 left-0 w-[500px] h-[500px] bg-[#b76e79]/10 rounded-full blur-[120px]"></div>
          <div className="absolute bottom-20 right-0 w-[600px] h-[600px] bg-[#301710]/5 rounded-full blur-[140px]"></div>

          <div className="max-w-6xl mx-auto px-8 relative">
            <div className="text-center mb-20">
              <div className="inline-block mb-8">
                <div className="flex items-center gap-4 mb-3">
                  <div className="w-16 h-px bg-gradient-to-r from-transparent to-[#b76e79]/40"></div>
                  <p className="text-[9px] uppercase tracking-[0.5em] text-[#b76e79]">
                    Add-On Services
                  </p>
                  <div className="w-16 h-px bg-gradient-to-l from-transparent to-[#b76e79]/40"></div>
                </div>
              </div>

              <h2
                className="text-[clamp(2.5rem,7vw,4.5rem)] text-[#301710] mb-6 leading-tight"
                style={{ fontFamily: "Cormorant, serif", fontWeight: 300, letterSpacing: "-0.01em" }}
              >
                Focused Brand Audits
              </h2>

              <p className="text-base text-[#301710]/70 font-light max-w-2xl mx-auto leading-relaxed">
                Targeted evaluations for brands that need clarity in specific areas
              </p>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
              {auditAddOns.map((audit, index) => (
                <div
                  key={audit.id}
                  className="group relative bg-white/60 backdrop-blur-sm p-12 hover:bg-white/80 transition-all duration-700"
                >
                  {/* Decorative corner accents */}
                  <div className="absolute top-0 left-0 w-12 h-12 border-t border-l border-[#b76e79]/20 group-hover:border-[#b76e79]/40 transition-colors"></div>
                  <div className="absolute top-0 right-0 w-12 h-12 border-t border-r border-[#b76e79]/20 group-hover:border-[#b76e79]/40 transition-colors"></div>
                  <div className="absolute bottom-0 left-0 w-12 h-12 border-b border-l border-[#b76e79]/20 group-hover:border-[#b76e79]/40 transition-colors"></div>
                  <div className="absolute bottom-0 right-0 w-12 h-12 border-b border-r border-[#b76e79]/20 group-hover:border-[#b76e79]/40 transition-colors"></div>

                  {/* Floating number badge */}
                  <div className="absolute -top-6 -right-6 w-14 h-14 bg-[#301710] flex items-center justify-center group-hover:scale-110 group-hover:bg-[#b76e79] transition-all duration-500">
                    <span
                      className="text-3xl text-[#f4e4e6]"
                      style={{ fontFamily: "Cormorant, serif", fontWeight: 300 }}
                    >
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  </div>

                  <div className="relative z-10">
                    <h3
                      className="text-3xl text-[#301710] mb-3 leading-tight"
                      style={{ fontFamily: "Cormorant, serif", fontWeight: 300 }}
                    >
                      {audit.name}
                    </h3>

                    <p className="text-sm text-[#301710]/70 font-light mb-8 leading-relaxed italic">
                      {audit.subtitle}
                    </p>

                    <div className="flex items-center gap-4 mb-10">
                      <span
                        className="text-2xl text-[#301710]/30 line-through"
                        style={{ fontFamily: "Cormorant, serif", fontWeight: 300 }}
                      >
                        {audit.price}
                      </span>
                      <span
                        className="text-5xl text-[#301710]"
                        style={{ fontFamily: "Cormorant, serif", fontWeight: 300 }}
                      >
                        {audit.salePrice}
                      </span>
                    </div>

                    <div className="space-y-6 mb-10">
                      <div>
                        <p className="text-[10px] uppercase tracking-[0.3em] text-[#b76e79] mb-2">
                          What This Covers
                        </p>
                        <p className="text-sm text-[#301710]/80 font-light leading-relaxed">
                          {audit.whatThisCovers}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] uppercase tracking-[0.3em] text-[#b76e79] mb-2">
                          What Is Identified
                        </p>
                        <p className="text-sm text-[#301710]/80 font-light leading-relaxed">
                          {audit.whatIsIdentified}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] uppercase tracking-[0.3em] text-[#b76e79] mb-2">
                          Outcome
                        </p>
                        <p className="text-sm text-[#301710]/80 font-light leading-relaxed">
                          {audit.outcome}
                        </p>
                      </div>
                    </div>

                    <button
                      onClick={() =>
                        handleAddToCart({
                          id: audit.id,
                          name: audit.name,
                          priceNum: audit.priceNum,
                          originalPriceNum: audit.originalPriceNum,
                          subtitle: audit.subtitle,
                          type: "service",
                        })
                      }
                      className={`w-full py-4 bg-[#301710] text-[#f4e4e6] text-center text-xs uppercase tracking-[0.4em] font-light ${
                        !isMobile ? "hover:bg-[#b76e79] hover:shadow-xl" : ""
                      } transition-all duration-500`}
                    >
                      Add to Cart
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Digital Products Section - Extended pastel pink background */}
        <div className="bg-[#f4e4e6] py-32 relative overflow-hidden">
          {/* Animated gradient orbs */}
          <div className="absolute top-40 right-20 w-[400px] h-[400px] bg-gradient-to-br from-[#b76e79]/15 to-transparent rounded-full blur-[100px] animate-pulse"></div>
          <div className="absolute bottom-40 left-20 w-[450px] h-[450px] bg-gradient-to-tr from-[#301710]/10 to-transparent rounded-full blur-[120px]"></div>
          <div className="max-w-7xl mx-auto px-8 relative">
            <div className="mb-32">
              <div className="text-center mb-16">
                <div className="inline-block mb-8">
                  <div className="flex items-center gap-4 mb-3">
                    <div className="w-20 h-px bg-gradient-to-r from-transparent to-[#b76e79]/40"></div>
                    <p className="text-[9px] uppercase tracking-[0.5em] text-[#b76e79]">
                      AVERRA Digital Products
                    </p>
                    <div className="w-20 h-px bg-gradient-to-l from-transparent to-[#b76e79]/40"></div>
                  </div>
                </div>

                <h2
                  className="text-[clamp(3rem,8vw,5rem)] text-[#301710] mb-8 leading-tight"
                  style={{ fontFamily: "Cormorant, serif", fontWeight: 300, letterSpacing: "-0.02em" }}
                >
                  Brand-Ready Visuals
                </h2>
                <p className="text-lg text-[#301710]/70 font-light max-w-2xl mx-auto mb-2 leading-relaxed">
                  Instant access. No revisions. Ready to use.
                </p>

                <div className="mt-10 mb-12 max-w-3xl mx-auto relative">
                  <div className="relative bg-white/50 backdrop-blur-sm px-10 py-6 border border-[#b76e79]/10">
                    {/* Corner decorations */}
                    <div className="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-[#b76e79]/30"></div>
                    <div className="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-[#b76e79]/30"></div>
                    <div className="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-[#b76e79]/30"></div>
                    <div className="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-[#b76e79]/30"></div>

                    <p
                      className="text-xs text-[#301710]/70 font-light leading-relaxed italic text-center"
                      style={{ fontFamily: "Cormorant, serif" }}
                    >
                      All visuals are AI-generated brand imagery created for marketing
                      and promotional use. These images are intended to elevate brand
                      presentation and should not be used to misrepresent real client
                      results or services not legally provided.
                    </p>
                  </div>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {digitalProducts.map((product, index) => (
                  <div
                    key={product.name}
                    className="group relative bg-white/60 backdrop-blur-sm p-10 hover:bg-white/90 hover:shadow-2xl transition-all duration-700"
                  >
                    {/* Subtle corner accents */}
                    <div className="absolute top-0 left-0 w-10 h-10 border-t border-l border-[#b76e79]/15 group-hover:border-[#b76e79]/40 transition-colors"></div>
                    <div className="absolute bottom-0 right-0 w-10 h-10 border-b border-r border-[#b76e79]/15 group-hover:border-[#b76e79]/40 transition-colors"></div>

                    {/* Product number badge */}
                    <div className="absolute -top-4 -right-4 w-12 h-12 bg-[#301710] group-hover:bg-[#b76e79] flex items-center justify-center transition-all duration-500 group-hover:scale-110">
                      <span
                        className="text-xl text-[#f4e4e6]"
                        style={{ fontFamily: "Cormorant, serif", fontWeight: 300 }}
                      >
                        {String(index + 1).padStart(2, '0')}
                      </span>
                    </div>
                  <h3
                    className="text-xl text-[#301710] mb-3"
                    style={{
                      fontFamily: "Cormorant, serif",
                      fontWeight: 300,
                    }}
                  >
                    {product.name}
                  </h3>
                  <div className="flex items-center gap-3 mb-4">
                    <span
                      className="text-lg text-[#301710]/40 line-through"
                      style={{
                        fontFamily: "Cormorant, serif",
                        fontWeight: 300,
                      }}
                    >
                      {product.originalPrice}
                    </span>
                    <span
                      className="text-3xl text-[#301710]"
                      style={{
                        fontFamily: "Cormorant, serif",
                        fontWeight: 300,
                      }}
                    >
                      {product.price}
                    </span>
                  </div>

                  {product.description && (
                    <p className="text-sm text-[#301710]/70 font-light mb-4 leading-relaxed">
                      {product.description}
                    </p>
                  )}

                  <div className="mb-4 space-y-2">
                    <p className="text-[10px] uppercase tracking-[0.3em] text-[#301710]/60 mb-3">
                      Inside This Pack:
                    </p>
                    {product.scenes?.map((scene, idx) => (
                      <div key={idx} className="mb-3">
                        <p className="text-xs text-[#301710] font-medium mb-1">
                          {scene.title}
                        </p>
                        <p className="text-xs text-[#301710]/70 font-light leading-relaxed">
                          {scene.detail}
                        </p>
                      </div>
                    ))}
                  </div>

                  <div className="mb-4 space-y-1">
                    {product.includes?.map((item, idx) => (
                      <p key={idx} className="text-xs text-[#301710]/70 font-light">
                        • {item}
                      </p>
                    ))}
                  </div>

                  <p
                    className="text-xs text-[#301710]/70 italic mb-6 leading-relaxed"
                    style={{ fontFamily: "Cormorant, serif" }}
                  >
                    {product.positioning}
                  </p>

                  <button
                    onClick={() =>
                      handleAddToCart({
                        id: product.id,
                        name: product.name,
                        priceNum: product.priceNum,
                        originalPriceNum: product.originalPriceNum,
                        type: "digital",
                      })
                    }
                    className={`group/btn relative inline-block w-full py-4 bg-[#301710] text-[#f4e4e6] text-center text-xs uppercase tracking-[0.4em] font-light overflow-hidden ${
                      !isMobile ? "hover:bg-[#b76e79] hover:shadow-xl" : ""
                    } transition-all duration-500`}
                  >
                    <span className="relative z-10">Add to Cart</span>
                    {/* Shine effect */}
                    <div className={`absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full ${!isMobile ? "group-hover/btn:translate-x-full" : ""} transition-transform duration-1000`}></div>
                  </button>
                </div>
              ))}
            </div>

            <div className="mt-16 text-center mx-auto max-w-4xl px-8 hidden md:block">
              <div className="h-px bg-gradient-to-r from-transparent via-[#b76e79]/20 to-transparent mb-8"></div>
              <p className="text-sm text-[#301710]/70 font-light leading-relaxed">
                All digital products include commercial use rights • Files
                delivered instantly after purchase • No edits, swaps, or
                personalization included
              </p>
              <div className="h-px bg-gradient-to-r from-transparent via-[#b76e79]/20 to-transparent mt-8"></div>
            </div>

            <div className="mt-16 mb-32 hidden md:block text-center">
              <div className="relative mx-auto max-w-6xl">
                {/* Enhanced corner accents */}
                <div className="absolute -top-4 -left-4 w-12 h-12 border-t-2 border-l-2 border-[#b76e79]/30"></div>
                <div className="absolute -top-4 -right-4 w-12 h-12 border-t-2 border-r-2 border-[#b76e79]/30"></div>
                <div className="absolute -bottom-4 -left-4 w-12 h-12 border-b-2 border-l-2 border-[#b76e79]/30"></div>
                <div className="absolute -bottom-4 -right-4 w-12 h-12 border-b-2 border-r-2 border-[#b76e79]/30"></div>

                <div className="bg-gradient-to-br from-[#301710] to-[#654331] px-24 py-12 relative overflow-hidden">
                  {/* Animated shimmer overlay */}
                  <div
                    className="absolute inset-0 opacity-10"
                    style={{
                      backgroundImage:
                        "repeating-linear-gradient(45deg, transparent, transparent 12px, rgba(255,255,255,.15) 12px, rgba(255,255,255,.15) 24px)",
                    }}
                  ></div>

                  {/* Glow effect */}
                  <div className="absolute inset-0 bg-gradient-to-r from-transparent via-[#b76e79]/10 to-transparent"></div>

                  <div className="relative z-10">
                    <div className="flex items-center justify-center gap-4 mb-4">
                      <div className="w-16 h-px bg-[#f4e4e6]/40"></div>
                      <span
                        className="text-[9px] uppercase tracking-[0.6em] text-[#f4e4e6]/70"
                        style={{
                          fontFamily: "Inter, sans-serif",
                          fontWeight: 300,
                        }}
                      >
                        Exclusive Offer
                      </span>
                      <div className="w-16 h-px bg-[#f4e4e6]/40"></div>
                    </div>

                    <p
                      className="text-5xl text-[#f4e4e6] mb-2"
                      style={{
                        fontFamily: "Cormorant, serif",
                        fontWeight: 300,
                        fontStyle: "italic",
                      }}
                    >
                      Limited Time Only
                    </p>

                    <p className="text-sm text-[#f4e4e6]/60 uppercase tracking-[0.3em]">
                      Founding Member Pricing
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>
        </div>
        <CTAFooter />
      </div>
    </>
  );
}
